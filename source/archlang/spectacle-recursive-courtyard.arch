# Spectacle program — Recursive Courtyard City
# A viral "impossible from a CAD mouse, trivial in code" plan:
# nested courtyards generated by a parametric loop. Change DEPTH and the
# whole city regenerates. Written in real ArchLang syntax for later hookup
# to `npx @chanmeng666/archlang compile`.
#
# Thesis: the shareable wonder is not a pretty render — it is a few lines
# of .arch that compile into a precise, lintable drawing no one would
# draft by hand.
plan "Spectacle — Recursive Courtyard" {
  units mm
  grid 50
  scale 1:200
  north up
  dims auto overall

  theme from "#8052ff"

  let WALL  = 200
  let GATE  = 1200
  let DEPTH = 5
  let BASE  = 48000

  # Outer shell
  wall exterior thickness WALL {
    (0, 0) (BASE, 0) (BASE, BASE) (0, BASE) close
  }
  room id=r_plaza at (0, 0) size BASE x BASE label "Plaza" uses living

  # Nested rings — each ring is a courtyard void carved by four corridor rooms.
  for i in 1..DEPTH {
    let inset = i * 4000
    let span  = BASE - 2 * inset
    let mid   = BASE / 2

    # North / South / East / West gallery bands
    room at (inset, inset)              size span x 3000 label "N{i}"
    room at (inset, BASE - inset - 3000) size span x 3000 label "S{i}"
    room at (inset, inset + 3000)       size 3000 x (span - 6000) label "W{i}"
    room at (BASE - inset - 3000, inset + 3000) size 3000 x (span - 6000) label "E{i}"

    # Four gates into the next courtyard
    door at (mid, inset)              width GATE wall exterior hinge left swing in
    door at (mid, BASE - inset)       width GATE wall exterior hinge left swing in
    door at (inset, mid)              width GATE wall exterior hinge left swing in
    door at (BASE - inset, mid)       width GATE wall exterior hinge left swing in
  }

  # Inner sanctum
  let core = DEPTH * 4000
  let cspan = BASE - 2 * core
  room id=r_core at (core, core) size cspan x cspan label "Sanctum" uses living
  furniture table in r_core centered size 2000x2000 label "Forum"

  title {
    project "Recursive Courtyard City"
    drawn_by "ArchLang"
    date "2026-11-06"
  }
}
